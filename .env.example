# Copy to .env with the setup script (it fills every CHANGE_ME with a random value):
#   macOS:    make setup
#   Windows:  ./scripts/dev.ps1 setup

# --- service -----------------------------------------------------------------
APP_ENV=local
DEPLOYMENT_PROFILE=vault
HOST=127.0.0.1
PORT=8000
# Admin key the terminal chat (make chat) sends; create one with the keys script. Never commit it.
AI_TWIN_ADMIN_KEY=
LOG_LEVEL=INFO
# auto = coloured console on a terminal, JSON when piped
LOG_FORMAT=auto

# --- local stack (deploy/compose.yml) ------------------------------------------
MONGO_ROOT_USERNAME=ai_twin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_PORT=27018
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6380
QDRANT_API_KEY=CHANGE_ME
QDRANT_HTTP_PORT=6334
QDRANT_GRPC_PORT=6335

# --- connection strings the app uses (setup keeps them in step with the values above) --
MONGODB_URI=mongodb://ai_twin:CHANGE_ME@127.0.0.1:27018/?authSource=admin
MONGODB_DATABASE=ai_twin
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380/0
QDRANT_URL=http://127.0.0.1:6334

# --- storage -----------------------------------------------------------------------
# Raw files, Fernet-encrypted and content-addressed (relative paths are from the repo root)
BLOB_DIR=vault/blobs
BLOB_ENCRYPTION_KEY=CHANGE_ME
VISITOR_HASH_SALT=CHANGE_ME
EMBEDDING_DIM=384
CONVERSATION_CACHE_TURNS=20
PUBLIC_CONVERSATION_RETENTION_DAYS=90
# Vault export/import read EXPORT_PASSPHRASE from the environment for automation;
# never put it in this file. Without it they prompt.

# --- compose runtime override (optional): "docker compose" | "docker-compose" | "podman compose"
AI_TWIN_COMPOSE=

# --- models (llm-orchestrator; inventory in config/models.yaml) ------------------
# A provider whose key is empty is disabled, not an error. Only public text goes to Gemini and
# OpenRouter free tiers; confidential text only ever goes to Ollama (local).
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Paid APIs, for public and private text only (confidential always stays on local models).
# Their entries in config/models.yaml start disabled; Anthropic also needs:
#   uv add --package llm-orchestrator langchain-anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Native Ollama on this machine (never a container, never another host):
#   make ollama ARGS="install" / "start" / "pull" / "smoke"   (Windows: ./scripts/dev.ps1 ollama ...)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Empty = the model named in config/models.yaml (llama3.2:3b, ~2 GB); llama3.2:1b for small machines
OLLAMA_MODEL=
# Empty = the quality local model in config/models.yaml (qwen2.5:7b, ~4.7 GB), used first for
# confidential answers; slow on a CPU-only machine
OLLAMA_QUALITY_MODEL=
# Empty = the strongest local model (qwen2.5:14b, ~9 GB), pinned by the super agent
OLLAMA_MAX_MODEL=
# TypeSafe Jev classifier (public tier only, used when FF_JEV_ENABLED=true)
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
LLM_TIMEOUT_SECONDS=30
# Ollama/local models (CPU laptops need longer for long prompts; also the first-token wait)
LLM_LOCAL_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
# Defaults to config/models.yaml in the repo
# MODEL_INVENTORY_PATH=config/models.yaml
# Offline stand-in model for keyless runs; never use it for real answers
LLM_MOCK_ENABLED=false

# --- ingestion (vault) ----------------------------------------------------------
INGEST_MAX_FILES=20
INGEST_MAX_FILE_MB=25
INGEST_WORKERS=2
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
URL_FETCH_TIMEOUT_SECONDS=15
# Local model files (spaCy en_core_web_md, fastembed); setup downloads them, export skips them
MODELS_DIR=vault/models
# Owner-maintained employer denylist (git-ignored); template: config/denylist.example.yaml
DENYLIST_PATH=vault/config/denylist.yaml
# Comma-separated strings redaction keeps (your published e-mail, phone, name)
PUBLIC_CONTACT_ALLOWLIST=
# Your own name's spellings, kept by redaction (e.g. "Kavya Rao,K. Rao"); empty = PUBLIC_OWNER_NAME
OWNER_NAMES=
# Comma-separated owner/name list; GitHub sync refuses every other repository
# owner/name syncs the default branch; owner/name@develop syncs develop unless a request names one
GITHUB_SYNC_REPOS=
# Optional, read-only (public repos work without it, at a lower rate limit)
GITHUB_TOKEN=

# --- retrieval and owner chat (vault) --------------------------------------------
RETRIEVAL_PREFETCH=30
RETRIEVAL_TOP_K=6
# Cross-encoder cut-off on a 0..1 scale; weaker chunks are dropped before generation.
RERANK_MIN_SCORE=0.01
OWNER_CONTEXT_TOKENS=3000
OWNER_HISTORY_TURNS=8
# Rolling conversation summary: refreshed in the background after this many new turns (0: on exit only)
SUMMARY_EVERY_TURNS=6
# Learned owner memories wait for review (make memory); true activates confidence >= 0.8
MEMORY_AUTO_ACCEPT=false
MEMORY_SIMILARITY=0.90
# Owner prompt budgets: active memories (items, tokens) and the summary of long chats
MEMORY_CONTEXT_ITEMS=20
MEMORY_CONTEXT_TOKENS=400
SUMMARY_CONTEXT_TOKENS=300

# --- owner intake assistant (vault: make twin) -------------------------------------
# Finished intake drafts are pruned after this many days; a pending confirmation is kept.
INTAKE_CHECKPOINT_DAYS=30
# ingest_file reads only from this folder, by file name (never paths, symlinks or ..).
INTAKE_INBOX_DIR=vault/inbox
# "yesterday", "last Friday", "12/10" resolve in this zone, day first (12/10 = 12 October).
OWNER_TIMEZONE=Asia/Kolkata
# After an ingest, wait this long for the job before reporting its status.
INTAKE_INGEST_WAIT_SECONDS=30

# --- public agent (/v1/chat, /v1/resume, /v1/assistant) ----------------------------
# Per visitor (salted hash of X-Visitor-Address), and every visitor together per UTC day
PUBLIC_MESSAGES_PER_MINUTE=8
PUBLIC_MESSAGES_PER_DAY=60
PUBLIC_DAILY_MESSAGE_CAP=1500
# Input guard: length cap, then rules, then Llama Prompt Guard 2 (Groq; `guard` role)
PUBLIC_MAX_MESSAGE_CHARS=800
# Scores above the threshold block; from BORDERLINE up to it Jev gives a second opinion
# when FF_JEV_ENABLED=true
PROMPT_GUARD_THRESHOLD=0.5
PROMPT_GUARD_BORDERLINE=0.2
PUBLIC_CONTEXT_TOKENS=1500
PUBLIC_HISTORY_TURNS=4
# Single-turn answers cached per question and kb_public_version (bumped on publish); 0 = off
PUBLIC_ANSWER_CACHE_TTL_SECONDS=21600
# Shown in the widget greeting and AI-twin disclosure; empty = "the owner"
PUBLIC_OWNER_NAME=
# Public profile only: the resume PDF to serve at /v1/resume (the vault serves the profile's
# resume blob). Unset = 404.
# PUBLIC_RESUME_PATH=/run/ai-twin/resume.pdf
# Public profile only: synced canary hashes (sync format in app/guardrails/canary_hashes.py).
# The vault reads the canaries collection instead.
# PUBLIC_CANARY_HASHES_PATH=/run/ai-twin/canary-hashes.json

# --- opportunities: lead capture, the form endpoint and the owner's email ---------
# Turns the assistant spends asking for missing details before it falls back to the contact form
LEAD_MAX_TURNS=6
# Leads per visitor per day, and from every visitor together per UTC day (over = polite refusal)
LEAD_VISITOR_DAILY_CAP=2
LEAD_DAILY_CAP=30
# Leads are deleted this many days after they arrive (TTL index)
LEAD_RETENTION_DAYS=365
# SMTP for the owner's lead email. Gmail: smtp.gmail.com, 587, starttls, your address as the
# username and an app password (Google Account -> Security -> App passwords; needs 2-Step
# Verification). Empty SMTP_HOST = leads are stored but not emailed until it is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587) | tls (465) | none (a local debug server only)
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=20
# The only recipient lead mail ever has, and the From address (both the owner's own)
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Cloudflare Turnstile secret (free). Empty = submits are not verified (local development only)
TURNSTILE_SECRET_KEY=

# --- observability: traces, metrics, security alerts -----------------------------
# OTLP/HTTP traces endpoint for the request spans (e.g. http://localhost:4318/v1/traces).
# Empty = spans stay local (they still put trace_id on every log line and X-Trace-ID on responses).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Langfuse (Cloud Hobby is free: cloud.langfuse.com or us.cloud.langfuse.com; or self-hosted).
# All three set = one trace per agent run; any missing = tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Owner, intake, ingestion and title content is masked in traces. true = send it, for a
# self-hosted Langfuse only (refused at startup with a langfuse.com URL).
LANGFUSE_OWNER_CONTENT=false
# Public questions and answers are traced with emails, phones and IDs masked; false masks them.
LANGFUSE_PUBLIC_CONTENT=true
# Fraction of runs traced (the Hobby plan has a monthly quota)
LANGFUSE_SAMPLE_RATE=1.0
# Public profile only: bearer token for GET /metrics (empty = 404). The vault's /metrics is open.
METRICS_TOKEN=
# Security alert emails use the SMTP settings above. Recipient: the owner only; empty = LEAD_EMAIL_TO
ALERT_EMAIL_TO=
# One email per policy per cooldown; a storm sends one email and a count
ALERT_COOLDOWN_MINUTES=30
# The daily security digest goes after this hour (0-23) in OWNER_TIMEZONE
ALERT_DIGEST_HOUR=9
ALERT_POLL_SECONDS=30

# --- feature flags -------------------------------------------------------------
FF_JEV_ENABLED=false
